# ==============================================================================
# Delhi Real-Time Bus Traffic Model & Journey Planner
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Add your genuine Delhi Transport Stack API key below if live tracking is required.
# 3. DO NOT commit `.env` or real API credentials to source control.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Serving Database Paths
# Primary active DLM1 static GTFS SQLite database
DB_PATH=/tmp/delhi_dlm1.db
SERVING_DB_PATH=/tmp/delhi_dlm1.db

# Fallback / Rollback pilot corridor database (Milestones 1-10)
HISTORICAL_LEGACY_DB_PATH=/tmp/delhi_mdb.db

# Config and Data Paths
CONFIG_PATH=config/planner.yaml
RAW_GPS_DIR=data/raw/gps
RAW_GTFS_DIR=data/raw/gtfs
PROCESSED_DATA_DIR=data/processed

# Real-Time GTFS-RT Configuration (Delhi Transport Stack - Open Transit Data)
# Obtain genuine API keys from: https://delhi.transportstack.in
DELHI_TRANSPORTSTACK_API_KEY=your_delhi_transportstack_api_key_here
DELHI_GTFS_RT_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb

# Live Feed Operational Controls
LIVE_FEED_ENABLED=true
LIVE_POLL_INTERVAL_SECONDS=30
LIVE_FEED_STALENESS_SECONDS=900

# Operational System Status
OVERALL_OPERATIONAL_STATUS=DEGRADE
LOG_LEVEL=INFO
