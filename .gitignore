# ==============================================================================
# Git Ignore Configuration - Delhi Bus Journey Planner
# (Full-stack: FastAPI/Python backend, Vite/React/TS frontend, Data Pipelines)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 2. Environment Variables & Credentials (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup*
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local

# Allow committing sample/example configuration templates
!.env.example
!backend/.env.example
!frontend/.env.example

# SSL Certificates and Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments & Packages
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
lib/
lib64/
include/
parts/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 4. Python Bytecode, Caches & Linters
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type Checking & Linting caches
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# 5. Jupyter Notebooks
# ------------------------------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# 6. Node.js & Frontend Build Outputs (Vite / React / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.vite/
frontend/.vite/
coverage/
frontend/coverage/

# TypeScript build info
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 7. IDE, Editor & Tooling Metadata
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace

# ------------------------------------------------------------------------------
# 8. Large Datasets, Databases & Archives (GitHub 100MB limit protection)
# ------------------------------------------------------------------------------
# SQLite Databases & WAL/SHM temp files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
/tmp/delhi_*.db

# Compressed archives & raw datasets
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.bz2
*.xz
*.rar

# Columnar / Scientific data formats
*.parquet
*.feather
*.arrow
*.h5
*.hdf5

# Project specific heavy data directories
data/serving/*.db
data/raw/gps/*
!data/raw/gps/.gitkeep
data/external/*
!data/external/.gitkeep
data/processed/gps_parquet/
data/processed/quarantine/
data/processed/stop_crossings/

# ------------------------------------------------------------------------------
# 9. Machine Learning Model Checkpoints & Weights
# ------------------------------------------------------------------------------
data/models/*.bin
data/models/*.joblib
data/models/*.pkl
data/models/*.pickle
data/models/*.onnx
data/models/*.pt
data/models/*.pth
data/models/*.safetensors

# ------------------------------------------------------------------------------
# 10. Temporary Outputs, Logs & Evaluation Artifacts
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/
/tmp/
reports/screenshots/
frontend/screenshots/
